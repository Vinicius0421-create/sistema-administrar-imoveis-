  // Snapshot do link de destino (ex: entidade "ChamadoManutencao", entidadeId
  // do chamado) — usado pelo frontend pra navegar direto ao clicar; ambos
  // opcionais porque SISTEMA_AVISO não aponta pra nenhum registro.
  entidade        String?
  entidadeId      String?
  lida            Boolean              @default(false)
  lidaEm          DateTime?
  criadoEm        DateTime             @default(now())

  // destinatarioId+lida: contagem de não-lidas (consulta mais frequente,
  // roda a cada conexão SSE aberta/reconectada). destinatarioId+criadoEm:
  // listagem paginada mais recente primeiro.
  @@index([destinatarioId, lida])
  @@index([destinatarioId, criadoEm])
  @@index([categoria])
  @@map("notificacoes")
}


