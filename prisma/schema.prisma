// Linha do tempo de um chamado — cobre "histórico completo" e "conversar com
// suporte" pedidos na Evolução Completa num único modelo: cada mudança de
// status/atribuição vira um evento de sistema, cada mensagem de chat vira um
// evento tipo MENSAGEM, tudo ordenado por criadoEm. anexoUrl já existe pronto
// pra quando a decisão de onde guardar arquivo (Cloudflare R2 x volume x
// base64) for tomada — não vai exigir migração nova, só ligar o upload.
//
// Decisão tomada em 06/07/2026: Railway Volume (disco persistente anexado ao
// próprio serviço backend, montado em /data/anexos via ANEXOS_DIR). Motivo:
// zero conta de terceiro pra criar, fica automaticamente privado (o arquivo
// só é servido através da API já autenticada, sem precisar de URL assinada)
// e o volume já cabe décadas de fotos de chamado no ritmo atual. Cloudflare
// R2 fica como caminho de evolução se o volume crescer muito ou precisar de
// CDN (ver Plano_Evolucao_Sistema_Corporativo.md no projeto Claude).
// ANEXO usa exatamente os campos que já existiam: anexoUrl guarda o caminho
// relativo dentro do volume, detalhe guarda { nomeArquivoOriginal, mimeType,
// tamanhoBytes } — ver rotas em chamados.routes.ts.
enum TipoEventoChamado {
  ABERTURA
  MENSAGEM
  MUDANCA_STATUS
  ATRIBUICAO
  ATUALIZACAO
  ANEXO
  // Recuperados 07/08/2026 a partir do uso real em chamados.routes.ts
  REABERTURA
  AVALIACAO
}

model ChamadoEvento {
  id        String   @id @default(cuid())
  chamadoId String
  chamado   ChamadoManutencao @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  tipo      TipoEventoChamado
  autorId   String?
  autor     Usuario? @relation("AutorEventoChamado", fields: [autorId], references: [id])
  mensagem  String?
  detalhe   Json?
  anexoUrl  String?
  criadoEm  DateTime @default(now())

  @@index([chamadoId])
  @@map("chamado_eventos")
}

model ChamadoManutencao {
  id                String   @id @default(cuid())
  // Número sequencial visível pro usuário (ex: "Chamado #47") — id (cuid)
  // continua sendo a chave primária real, numero é só pra exibição/busca
  // humana, pedido explicitamente na Evolução Completa.
  numero            Int      @unique @default(autoincrement())
  solicitanteId     String
  solicitante       Colaborador @relation("SolicitanteChamado", fields: [solicitanteId], references: [id])
  categoria         CategoriaChamado
  equipamentoId     String?
  equipamento       Equipamento? @relation(fields: [equipamentoId], references: [id])
  descricao         String
  // Local físico do problema (ex: "Sala TI", "Recepção Itaúna") — distinto da
  // localização do equipamento em si, porque nem todo chamado tem um
  // equipamento vinculado (ex: "sem internet na sala X").
  local             String?
  // Unidade obrigatória (07/07/2026, pedido do Vini — recuperado 07/08/2026)
  unidadeId         String
  unidade           Unidade  @relation(fields: [unidadeId], references: [id])
  // Integração Imoview (recuperado 07/08/2026, ver TipoSolicitacaoImoview)
  tipoSolicitacaoImoview TipoSolicitacaoImoview?
  codigoImovel      String?
  // Quantas vezes o chamado foi reaberto depois de ter sido marcado como
  // resolvido/encerrado — usado no painel de qualidade de atendimento.
  reaberturas       Int @default(0)
  prioridade        Prioridade @default(MEDIA)
  responsavelId     String?
  responsavel       Usuario? @relation("Responsavel", fields: [responsavelId], references: [id])
  fornecedorExterno String?
  status            StatusChamado @default(ABERTO)
  slaPrazo          DateTime?
  valorPrevisto     Decimal? @db.Decimal(10, 2)
  valorFinal        Decimal? @db.Decimal(10, 2)
  dataAbertura      DateTime @default(now())
  dataConclusao     DateTime?
  observacoes       String?
  // Visível só pra quem administra o chamado (Administrador/Suporte TI) —
  // nunca aparece pro colaborador que abriu o chamado. Filtrado na camada de
  // API (ver chamados.routes.ts), não só escondido na tela.
  observacoesInternas String?
  // Visível pro colaborador — é a explicação do que foi feito, diferente das
  // observações internas acima.
  solucaoAplicada   String?
  // Avaliação do atendimento pelo solicitante, só depois do chamado terminal
  // (ver STATUS_TERMINAIS em chamados.routes.ts) — recuperado 07/08/2026.
  avaliacaoNota       Int?
  avaliacaoComentario String?
  avaliadoEm          DateTime?
  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt

  eventos ChamadoEvento[]

  @@index([status])
  @@map("chamados_manutencao")
}

