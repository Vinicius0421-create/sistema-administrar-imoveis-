  // ChamadoManutencao.numero (cuid continua sendo a chave primária real).
  numero Int    @unique @default(autoincrement())

  tipo TipoSolicitacaoPapelaria

  unidadeId String
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  // "Responsável pela solicitação" do pedido original — preenchido com o
  // usuário logado no momento da criação; só ADMINISTRADOR/GESTOR_COORDENADOR
  // podem escolher outra pessoa (checado na rota, não no schema).
  responsavelId String
  responsavel   Usuario @relation("ResponsavelSolicitacaoPapelaria", fields: [responsavelId], references: [id])

  aprovadorId String?
  aprovador   Usuario? @relation("AprovadorSolicitacaoPapelaria", fields: [aprovadorId], references: [id])

  // "Quem de fato enviou" — normalmente igual a responsavelId, mas difere
  // quando um ADMINISTRADOR/GESTOR_COORDENADOR cria a solicitação "em nome
  // de" outra pessoa (responsavelId = a pessoa delegada, criadoPorId =
  // usuário logado que efetivamente enviou). Campo recuperado 07/08/2026 a
  // partir do uso real em solicitacoesPapelaria.routes.ts (não estava no
  // dump original do model encontrado nas transcrições).
  criadoPorId String?
  criadoPor   Usuario? @relation("CriadorSolicitacaoPapelaria", fields: [criadoPorId], references: [id])

  status          StatusSolicitacaoPapelaria @default(RASCUNHO)
  prioridade      Prioridade                 @default(MEDIA)
  // Obrigatória para AVULSA (checado na rota) — dispensável para MENSAL, que
  // já é periódica e previsível por natureza.
  justificativa   String?
  observacoes     String?
  dataSolicitacao DateTime                   @default(now())
  dataConclusao   DateTime?
  criadoEm        DateTime                   @default(now())
  atualizadoEm    DateTime                   @updatedAt

  itens   ItemSolicitacaoPapelaria[]
  eventos EventoSolicitacaoPapelaria[]

  @@index([status])
  @@index([unidadeId])
  @@index([responsavelId])
  @@index([tipo])
  @@index([prioridade])
  @@map("solicitacoes_papelaria")
}

model ItemSolicitacaoPapelaria {
  id            String               @id @default(cuid())
  solicitacaoId String
  solicitacao   SolicitacaoPapelaria @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)

  // Referência ao catálogo quando o item veio de lá (o caminho recomendado);
  // fica null para item avulso. `nomeProduto` é sempre preenchido como uma
  // cópia (snapshot) do nome no momento da solicitação — garante que o
  // histórico continua legível mesmo se o produto for renomeado ou removido
  // do catálogo depois (onDelete: SetNull preserva o item, só solta o vínculo).
  produtoId   String?
  produto     ProdutoPapelaria? @relation(fields: [produtoId], references: [id], onDelete: SetNull)
  nomeProduto String

  // Sempre preenchida (vem do produto do catálogo quando produtoId existe,
  // ou escolhida manualmente para item avulso) — mantém os indicadores "por
  // categoria" do dashboard consistentes independentemente da origem do item.
  categoriaId String
  categoria   CategoriaProdutoPapelaria @relation(fields: [categoriaId], references: [id])

  quantidade    Int                  @default(1)
  unidadeMedida UnidadeMedidaProduto @default(UNIDADE)
  observacoes   String?
  criadoEm      DateTime             @default(now())

  @@index([solicitacaoId])
  @@index([produtoId])
  @@map("itens_solicitacao_papelaria")
}

model EventoSolicitacaoPapelaria {
  id            String               @id @default(cuid())
  solicitacaoId String
  solicitacao   SolicitacaoPapelaria @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)

  tipo    TipoEventoSolicitacaoPapelaria
  autorId String?
  autor   Usuario?                       @relation("AutorEventoSolicitacaoPapelaria", fields: [autorId], references: [id])

  mensagem String?
  detalhe  Json?
  criadoEm DateTime @default(now())

  @@index([solicitacaoId])
  @@map("eventos_solicitacao_papelaria")
}

// ==== Catálogo de acessórios/anexos de Equipamento (recuperado 07/08/2026) ====
model CategoriaProdutoEquipamento {
  id     String             @id @default(cuid())
  nome   String             @unique
  status StatusAtivoInativo @default(ATIVO)

  produtos     ProdutoEquipamento[]
  // Back-relation de SolicitacaoEquipamento.categoriaId (recuperado 07/08/2026)
  solicitacoes SolicitacaoEquipamento[]

  @@map("categorias_produto_equipamento")
}

// Reconstruído 07/08/2026 a partir do uso real em dominios.routes.ts (rotas
// /produtos-equipamento) — o bloco original do model não foi encontrado nas
// transcrições, mas o schema de entrada/saída da rota (nome único,
// categoriaId obrigatório, status opcional no PATCH) deixa os campos
// inequívocos. SolicitacaoEquipamento.produtoId referencia este model
// (ON DELETE SET NULL — ver comentário em SolicitacaoEquipamento).
model ProdutoEquipamento {
  id          String                      @id @default(cuid())
  nome        String                      @unique
  categoriaId String
  categoria   CategoriaProdutoEquipamento @relation(fields: [categoriaId], references: [id])
  status      StatusAtivoInativo          @default(ATIVO)
  criadoEm    DateTime                    @default(now())
  atualizadoEm DateTime                   @updatedAt

  solicitacoes SolicitacaoEquipamento[]

  @@index([categoriaId])
  @@map("produtos_equipamento")
}

model AcessorioEquipamento {
  id          String               @id @default(cuid())
  nome        String
  categoriaId String
  categoria   CategoriaEquipamento @relation(fields: [categoriaId], references: [id])
  status      StatusAtivoInativo   @default(ATIVO)
  criadoEm    DateTime             @default(now())

  equipamentos EquipamentoAcessorio[]

  @@unique([nome, categoriaId])
  @@index([categoriaId])
  @@map("acessorios_equipamento")
}

model EquipamentoAcessorio {
  id            String               @id @default(cuid())
  equipamentoId String
  equipamento   Equipamento          @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
  acessorioId   String
  acessorio     AcessorioEquipamento @relation(fields: [acessorioId], references: [id])
  criadoEm      DateTime             @default(now())

  @@unique([equipamentoId, acessorioId])
  @@index([equipamentoId])
  @@index([acessorioId])
  @@map("equipamento_acessorios")
}

model AnexoEquipamento {
  id            String      @id @default(cuid())
  equipamentoId String
  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
  url           String
  // Nome GENÉRICO gerado pelo servidor ("foto-equipamento.jpg" etc.), NÃO o
  // nome original do upload — pedido do Vini (17/07/2026): "não pegue o nome
  // original do arquivo, apenas o tamanho e a data". Nome de arquivo de
  // celular vaza informação (data/hora/app de origem) e polui a tela; aqui o
  // campo existe só pra dar um nome válido ao download (Content-Disposition)
  // e carregar a extensão certa.
  nomeOriginal  String
  tipo          String
  tamanhoBytes  Int
  // Posição na lista (17/07/2026, pedido do Vini: "que eu consiga arrastar e
  // reorganizar") — 0-based, reescrita em bloco pela rota PATCH
  // /equipamentos/:id/anexos/ordem a cada arrasto. Novo upload entra no fim
  // (max(ordem)+1).
  ordem         Int         @default(0)
  enviadoPorId  String?
  enviadoPor    Usuario?    @relation(fields: [enviadoPorId], references: [id])
  criadoEm      DateTime    @default(now())

  @@index([equipamentoId])
  @@map("anexos_equipamento")
}


// ==== Preferências e canais extras (recuperado 07/08/2026) ====
model PreferenciaNotificacao {
  id                    String                 @id @default(cuid())
  usuarioId             String                 @unique
  usuario               Usuario                @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  categoriasSilenciadas CategoriaNotificacao[]
  prioridadeMinima      Prioridade             @default(BAIXA)
  som                   Boolean                @default(true)
  notificacaoNavegador  Boolean                @default(true)
  atualizadoEm          DateTime               @updatedAt

  @@map("preferencias_notificacao")
}

model PreferenciaUsuario {
  id           String      @id @default(cuid())
  usuarioId    String      @unique
  usuario      Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tema         TemaUsuario @default(SISTEMA)
  atualizadoEm DateTime    @updatedAt

  @@map("preferencias_usuario")
}

enum TemaUsuario {
  CLARO
  ESCURO
  SISTEMA
}

model AcessoCanalExtra {
  id            String       @id @default(cuid())
  colaboradorId String?
  colaborador   Colaborador? @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  setorOrigemId String?
  setorOrigem   Setor?       @relation("SetorOrigemAcessoExtra", fields: [setorOrigemId], references: [id], onDelete: Cascade)

  tipo             TipoMensagem
  setorDestinoId   String?
  setorDestino     Setor?       @relation("SetorDestinoAcessoExtra", fields: [setorDestinoId], references: [id], onDelete: Cascade)
  unidadeDestinoId String?
  unidadeDestino   Unidade?     @relation(fields: [unidadeDestinoId], references: [id], onDelete: Cascade)

  observacao String?
  criadoEm   DateTime @default(now())

  @@index([colaboradorId])
  @@index([setorOrigemId])
  @@map("acessos_canal_extra")
}


// ==== Marcação de leitura de canal (recuperado 07/08/2026) ====
model LeituraCanal {
  id           String       @id @default(cuid())
  usuarioId    String
  usuario      Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo         TipoMensagem
  // Id da Unidade ou do Setor conforme `tipo` — mesma convenção de
  // Mensagem.unidadeId/setorId, só que aqui unificado num campo só porque
  // nunca precisamos filtrar/juntar por ele separadamente, só checar
  // usuarioId+tipo+canalId como uma chave composta.
  canalId      String
  lidaAte      DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt

  @@unique([usuarioId, tipo, canalId])
  @@map("leituras_canal")
}
