// Schema do backend "Administrar Imóveis".
// Migrado a partir de duas fontes que precisavam ser conciliadas:
//   1) Estrutura_Sistema_Airtable_Administrar.md (modelo relacional original)
//   2) sistema-administrar-imoveis.jsx (protótipo React com storage local)
// Duas correções estruturais em relação ao protótipo:
//   - Nomes de colaborador deixam de ser duplicados como string em cada tabela
//     filha (equipamento.colaboradorNome etc.) — agora só existe a FK, e o nome
//     é resolvido via join/include no momento da leitura.
//   - Autenticação (Usuario) e trilha de auditoria (AuditLog) passam a existir
//     de fato, substituindo o seletor de papel client-side do protótipo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Domínio / listas mestras
// ---------------------------------------------------------------------------

model Unidade {
  id     String   @id @default(cuid())
  nome   String   @unique
  status StatusAtivoInativo @default(ATIVO)

  colaboradores       Colaborador[]
  linhas              LinhaTelefonica[]
  // Back-relation de SolicitacaoEquipamento.unidadeId (recuperado 07/08/2026)
  solicitacoes        SolicitacaoEquipamento[]
  movimentacoesOrigem MovimentacaoColaborador[] @relation("UnidadeAnterior")
  movimentacoesDestino MovimentacaoColaborador[] @relation("NovaUnidade")
  // Relações recuperadas junto com Mensagem/SolicitacaoServico (07/08/2026)
  mensagens            Mensagem[]
  solicitacoesServico  SolicitacaoServico[]
  chamados             ChamadoManutencao[]
  // Relação recuperada junto com o módulo de Papelaria (07/08/2026)
  solicitacoesPapelaria SolicitacaoPapelaria[]
  // Back-relation de AcessoCanalExtra.unidadeDestinoId (recuperado 07/08/2026)
  acessosCanalExtraDestino AcessoCanalExtra[]

  @@map("unidades")
}

model Setor {
  id     String   @id @default(cuid())
  nome   String   @unique
  status StatusAtivoInativo @default(ATIVO)

  cargos               Cargo[]
  colaboradores        Colaborador[]
  movimentacoesOrigem  MovimentacaoColaborador[] @relation("SetorAnterior")
  movimentacoesDestino MovimentacaoColaborador[] @relation("NovoSetor")
  // Relação recuperada junto com Mensagem (07/08/2026)
  mensagens            Mensagem[]
  // Back-relations de AcessoCanalExtra (recuperado 07/08/2026)
  acessosCanalExtraOrigem  AcessoCanalExtra[] @relation("SetorOrigemAcessoExtra")
  acessosCanalExtraDestino AcessoCanalExtra[] @relation("SetorDestinoAcessoExtra")

  @@map("setores")
}

model Cargo {
  id      String @id @default(cuid())
  nome    String
  setorId String
  setor   Setor  @relation(fields: [setorId], references: [id])

  colaboradores Colaborador[]

  @@unique([nome, setorId])
  @@map("cargos")
}

model Empresa {
  id          String @id @default(cuid())
  razaoSocial String @unique
  cnpj        String? @unique

  linhas LinhaTelefonica[]

  @@map("empresas")
}

model SistemaAcesso {
  id        String  @id @default(cuid())
  nome      String  @unique
  descricao String?

  acessos AcessoSistema[]

  @@map("sistemas_acesso")
}

// Listas administráveis de Patrimônio (Fase 1 da Evolução Completa — antes
// "tipo"/"marca" eram texto livre digitado a cada cadastro; viram tabelas de
// domínio para permitir filtro/relatório consistente, sem remover os campos
// de texto livre originais — mantidos para não quebrar dados já existentes).
model CategoriaEquipamento {
  id     String @id @default(cuid())
  nome   String @unique
  status StatusAtivoInativo @default(ATIVO)

  equipamentos Equipamento[]
  // Back-relation do catálogo de acessórios (recuperado 07/08/2026)
  acessorios   AcessorioEquipamento[]

  @@map("categorias_equipamento")
}

model MarcaEquipamento {
  id     String @id @default(cuid())
  nome   String @unique
  status StatusAtivoInativo @default(ATIVO)

  equipamentos Equipamento[]

  @@map("marcas_equipamento")
}

// ---------------------------------------------------------------------------
// Autenticação e autorização
// Substitui o <select> "Ver como: ..." do protótipo, que não impunha nenhuma
// restrição real de acesso no servidor.
// ---------------------------------------------------------------------------

// RH e FINANCEIRO recuperados 07/08/2026 a partir do uso real em
// solicitacoesPapelaria.routes.ts (RH aprova solicitações; ambos aparecem em
// listas de autorização junto com ADMINISTRADOR) — não estavam no dump
// original de schema.prisma encontrado nas transcrições, mas a evidência de
// uso nas rotas é inequívoca. Consistente com o pedido bloqueado antes desta
// recuperação ("dar ao papel FINANCEIRO permissão de cadastrar colaborador").
enum Papel {
  ADMINISTRADOR
  GESTOR_COORDENADOR
  SUPORTE_TI
  COLABORADOR
  RH
  FINANCEIRO
}

model Usuario {
  id            String   @id @default(cuid())
  email         String   @unique
  senhaHash     String
  papel         Papel
  ativo         Boolean  @default(true)
  // Ativado sempre que uma senha temporária/compartilhada é atribuída (ex:
  // provisionamento em lote). Enquanto true, a API bloqueia qualquer rota
  // além de /auth/me e /auth/senha — obriga a pessoa a escolher uma senha
  // só dela antes de usar o resto do sistema.
  precisaTrocarSenha Boolean @default(true)
  colaboradorId String?  @unique
  colaborador   Colaborador? @relation(fields: [colaboradorId], references: [id])
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs     AuditLog[]
  solicitacoesAprovadas SolicitacaoEquipamento[] @relation("Aprovador")
  solicitacoesComoTecnico SolicitacaoEquipamento[] @relation("TecnicoResponsavelSolicitacao")
  chamadosResponsavel   ChamadoManutencao[]      @relation("Responsavel")
  movimentacoesResponsavel MovimentacaoColaborador[] @relation("ResponsavelMovimentacao")
  historicosResponsavel HistoricoTroca[]         @relation("ResponsavelHistorico")
  eventosChamadoAutor   ChamadoEvento[]          @relation("AutorEventoChamado")
  // Relações recuperadas junto com Mensagem/Notificacao/SolicitacaoServico (07/08/2026)
  mensagensEnviadas     Mensagem[]               @relation("MensagensEnviadas")
  mensagensRecebidas    Mensagem[]               @relation("MensagensRecebidas")
  notificacoesRecebidas Notificacao[]            @relation("DestinatarioNotificacao")
  notificacoesOrigem    Notificacao[]            @relation("OrigemNotificacao")
  eventosSolicitacaoServicoAutor SolicitacaoServicoEvento[] @relation("AutorEventoSolicitacaoServico")
  // Relações recuperadas junto com o módulo de Papelaria (07/08/2026)
  solicitacoesPapelariaResponsavel SolicitacaoPapelaria[] @relation("ResponsavelSolicitacaoPapelaria")
  solicitacoesPapelariaAprovadas   SolicitacaoPapelaria[] @relation("AprovadorSolicitacaoPapelaria")
  solicitacoesPapelariaCriadas     SolicitacaoPapelaria[] @relation("CriadorSolicitacaoPapelaria")
  eventosSolicitacaoPapelariaAutor EventoSolicitacaoPapelaria[] @relation("AutorEventoSolicitacaoPapelaria")
  // Back-relation de AnexoEquipamento.enviadoPorId (recuperado 07/08/2026)
  anexosEquipamentoEnviados AnexoEquipamento[]
  // Back-relations de preferências (recuperado 07/08/2026)
  preferenciaNotificacao PreferenciaNotificacao?
  preferenciaUsuario     PreferenciaUsuario?
  // Back-relation de LeituraCanal.usuarioId (recuperado 07/08/2026)
  leiturasCanal          LeituraCanal[]

  @@map("usuarios")
}

model RefreshToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  usuarioId  String
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEm   DateTime
  revogadoEm DateTime?
  // Agrupa tokens da mesma "linhagem" de rotação — permite revogar toda a
  // família de uma vez se um refresh token reusado (já revogado) for
  // apresentado de novo, sinal de possível roubo de token. Recuperado 07/08/2026.
  familyId   String?
  criadoEm   DateTime  @default(now())

  @@index([usuarioId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// "Esqueci minha senha" self-service (07/07/2026). Token opaco (não-JWT),
// hash guardado no banco (nunca o valor puro), uso único (usadoEm),
// expiração curta. Recuperado 07/08/2026 a partir do uso real em auth.routes.ts.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())

  @@index([usuarioId])
  @@map("password_reset_tokens")
}

// Trilha de auditoria — cobre o gap apontado na revisão do protótipo: acesso a
// dado sensível (CPF) e qualquer escrita relevante deve ficar rastreável.
model AuditLog {
  id         String   @id @default(cuid())
  usuarioId  String?
  usuario    Usuario? @relation(fields: [usuarioId], references: [id])
  acao       String   // ex: "LOGIN", "VISUALIZAR_CPF", "CRIAR", "ATUALIZAR", "EXCLUIR"
  entidade   String   // ex: "Colaborador", "Equipamento"
  entidadeId String?
  detalhe    Json?
  ip         String?
  criadoEm   DateTime @default(now())

  @@index([entidade, entidadeId])
  @@index([usuarioId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Colaboradores (tabela central)
// ---------------------------------------------------------------------------

enum StatusColaborador {
  ATIVO
  INATIVO
  AFASTADO
}

enum StatusAtivoInativo {
  ATIVO
  INATIVO
}

model Colaborador {
  id                String   @id @default(cuid())
  nomeCompleto      String
  // Opcional só para "contas de função" (ex: recepção de uma unidade, que
  // roda entre pessoas diferentes e não tem titular fixo). Para qualquer
  // colaborador de verdade, o CPF continua obrigatório via validação em
  // src/routes/colaboradores.routes.ts (colaboradorInputSchema).
  cpf               String?  @unique
  // Marca um registro como conta de função em vez de pessoa física — ex:
  // "Recepção Itaúna". Nome e responsável mudam com frequência; CPF não se
  // aplica. Ver colaboradores.routes.ts para a regra de validação condicional.
  contaFuncao       Boolean  @default(false)
  email             String?  @unique
  unidadeId         String?
  unidade           Unidade? @relation(fields: [unidadeId], references: [id])
  setorId           String?
  setor             Setor?   @relation(fields: [setorId], references: [id])
  cargoId           String?
  cargo             Cargo?   @relation(fields: [cargoId], references: [id])
  status            StatusColaborador @default(ATIVO)
  dataAdmissao      DateTime?
  dataDesligamento  DateTime?
  dataNascimento    DateTime?
  observacoes       String?
  fotoUrl           String?
  // Termo de responsabilidade digital assinado (recuperado 07/08/2026)
  termoResponsabilidadeUrl          String?
  termoResponsabilidadeNomeOriginal String?
  termoResponsabilidadeTipo         String?
  termoResponsabilidadeEnviadoEm    DateTime?
  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt

  usuario                Usuario?
  // Múltiplos telefones (07/08/2026, pedido do Vini) — substitui o antigo
  // campo único `telefone` (texto solto). Ver model TelefoneColaborador
  // abaixo; a migração que introduziu isso preserva o valor antigo como o
  // primeiro registro (principal=true) de cada colaborador que tinha
  // telefone preenchido.
  telefones              TelefoneColaborador[]
  equipamentos           Equipamento[]
  // Back-relation de Equipamento.ultimoColaboradorId (recuperado 07/08/2026)
  equipamentosAnteriores Equipamento[]             @relation("UltimoColaboradorEquipamento")
  linhas                 LinhaTelefonica[]
  // Back-relation de LinhaTelefonica.ultimoColaboradorId (recuperado 07/08/2026)
  linhasAnteriores       LinhaTelefonica[]         @relation("UltimoColaboradorLinha")
  // Back-relation de AcessoCanalExtra.colaboradorId (recuperado 07/08/2026)
  acessosCanalExtra      AcessoCanalExtra[]
  acessos                AcessoSistema[]
  solicitacoes           SolicitacaoEquipamento[] @relation("Solicitante")
  chamados               ChamadoManutencao[]      @relation("SolicitanteChamado")
  movimentacoes          MovimentacaoColaborador[]
  historicoComoOrigem    HistoricoTroca[]          @relation("ColaboradorOrigem")
  historicoComoDestino   HistoricoTroca[]          @relation("ColaboradorDestino")
  // Relação recuperada junto com SolicitacaoServico (07/08/2026)
  solicitacoesServico    SolicitacaoServico[]

  @@index([status])
  @@map("colaboradores")
}

// Múltiplos telefones por colaborador (07/08/2026, pedido do Vini) — antes
// só existia um campo de texto solto (`Colaborador.telefone`, "telefone de
// contato"). Continua sendo só o contato PESSOAL — não confundir com
// LinhaTelefonica, que é o sistema de linhas CORPORATIVAS da empresa
// (patrimônio próprio, com operadora/plano/status).
enum TipoTelefoneColaborador {
  CELULAR
  RESIDENCIAL
  COMERCIAL
  WHATSAPP
  OUTRO
}

model TelefoneColaborador {
  id            String   @id @default(cuid())
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  numero        String
  tipo          TipoTelefoneColaborador @default(CELULAR)
  // Um por colaborador, de verdade (índice único parcial verificado na
  // aplicação — mesmo padrão de LinhaTelefonica.principal em
  // linhas.routes.ts, ver desmarcarOutrasPrincipais lá). É o número usado
  // como "telefone de contato" em qualquer lugar do sistema que precise de
  // só UM número (ex: reconciliação de linha em linhas.routes.ts, PDF do
  // termo de responsabilidade).
  principal     Boolean  @default(false)
  observacao    String?
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  @@index([colaboradorId])
  @@map("telefones_colaborador")
}

// ---------------------------------------------------------------------------
// Equipamentos
// ---------------------------------------------------------------------------

enum EstadoConservacao {
  NOVO
  BOM
  REGULAR
  DANIFICADO
}

enum StatusEquipamento {
  EM_USO
  DISPONIVEL
  EM_MANUTENCAO
  BAIXADO
  // Adicionados na Evolução Completa (07/2026) — situações que já
  // aconteciam na prática (notebook com colaborador afastado, aparelho
  // extraviado, descarte formal) mas não tinham status próprio antes.
  EMPRESTADO
  PERDIDO
  DESCARTADO
}

model Equipamento {
  id                String   @id @default(cuid())
  tipo              String
  marca             String?
  modelo            String?
  numeroSerie       String?  @unique
  patrimonio        String?  @unique
  estadoConservacao EstadoConservacao?
  status            StatusEquipamento @default(DISPONIVEL)
  colaboradorId     String?
  colaborador       Colaborador? @relation(fields: [colaboradorId], references: [id])
  dataEntrega       DateTime?
  dataDevolucao     DateTime?
  observacoes       String?
  // Campos novos da Evolução Completa. categoriaId/marcaId referenciam as
  // novas tabelas de domínio; tipo/marca (texto livre) continuam existindo
  // e sendo aceitos, para não quebrar registros já cadastrados antes desta
  // mudança — a UI passa a preencher categoriaId/marcaId quando disponíveis.
  categoriaId       String?
  categoria         CategoriaEquipamento? @relation(fields: [categoriaId], references: [id])
  marcaId           String?
  marcaEquipamento  MarcaEquipamento? @relation(fields: [marcaId], references: [id])
  localizacao       String?
  dataAquisicao     DateTime?
  // Depreciação linear simples (recuperado 07/08/2026 a partir do uso real
  // em equipamentos.routes.ts, função comDepreciacao) — Decimal pra valor
  // monetário (nunca float), vidaUtilMeses em meses corridos (30,44
  // dias/mês na conta). Ambos opcionais: sem eles, a rota não calcula
  // valorAtual/depreciacaoAcumulada (retorna null nos dois).
  valorAquisicao    Decimal? @db.Decimal(10, 2)
  vidaUtilMeses     Int?
  // Foto do equipamento (recuperado 07/08/2026 — ver Relatorio_Acessorios_Foto_Equipamento_17-07-2026.md)
  fotoUrl           String?
  fotoNomeOriginal  String?
  fotoTipo          String?
  fotoEnviadaEm     DateTime?
  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt

  // "De quem era" (recuperado 07/08/2026 — ver
  // Relatorio_De_Quem_Era_Estoque_17-07-2026.md): salvo automaticamente
  // quando o equipamento perde/troca de dono (colaboradorId muda pra outro
  // valor ou null), guardando quem era o dono ANTERIOR — a UI só mostra esse
  // campo quando o equipamento está sem dono atual (em estoque).
  ultimoColaboradorId String?
  ultimoColaborador   Colaborador? @relation("UltimoColaboradorEquipamento", fields: [ultimoColaboradorId], references: [id])

  historico    HistoricoTroca[]
  chamados     ChamadoManutencao[]
  // Catálogo de acessórios vinculados e anexos/fotos (recuperado 07/08/2026)
  acessorios   EquipamentoAcessorio[]
  anexos       AnexoEquipamento[]

  @@index([status])
  @@index([colaboradorId])
  @@index([categoriaId])
  @@index([marcaId])
  @@index([ultimoColaboradorId])
  @@map("equipamentos")
}

// ---------------------------------------------------------------------------
// Linhas telefônicas
// ---------------------------------------------------------------------------

enum StatusLinha {
  ATIVA
  DISPONIVEL
  CANCELADA
  BLOQUEADA
}

// Novo na Evolução Completa (07/2026). Default POS_PAGO porque todas as
// linhas cadastradas até aqui são pós-pagas corporativas — o próprio Prisma
// aplica esse default em toda linha já existente na migração, exatamente
// como pedido: "todas as linhas já existentes classificadas como pós-pagas".
enum TipoPlano {
  POS_PAGO
  PRE_PAGO
}

model LinhaTelefonica {
  id                    String   @id @default(cuid())
  numero                String   @unique
  operadora             String?
  plano                 String?
  tipoPlano             TipoPlano @default(POS_PAGO)
  empresaId             String?
  empresa               Empresa? @relation(fields: [empresaId], references: [id])
  colaboradorId         String?
  colaborador           Colaborador? @relation(fields: [colaboradorId], references: [id])
  // Campo de transição herdado da planilha original: nome digitado livremente
  // quando a linha ainda não tinha vínculo formal com um colaborador cadastrado.
  // Mantido só para permitir reconciliação manual; não deve ser usado como
  // fonte de verdade quando colaboradorId estiver preenchido.
  colaboradorInformado  String?
  unidadeId             String?
  unidade               Unidade? @relation(fields: [unidadeId], references: [id])
  // Marca a linha "de contato" do colaborador quando ele tem mais de uma —
  // usada pra escolher qual número exibir em listagens/relatórios resumidos
  // (equipamentos.routes.ts busca a linha `principal: true` do colaborador).
  // Recuperado 07/08/2026 a partir do uso real nas rotas.
  principal             Boolean  @default(false)
  // Conferência periódica da carteira de linhas (recuperado 07/08/2026 a
  // partir do uso real na rota — valores confirmados em types.ts do
  // frontend). NECESSITA_CONFERENCIA sinaliza pendência (ver
  // Relatorio_Revisao_Semanal_20-07-2026.md); NAO_VERIFICADO é o estado
  // inicial de toda linha nova.
  situacaoConferencia   SituacaoConferenciaLinha @default(NAO_VERIFICADO)
  // "De quem era" (mesmo padrão de Equipamento.ultimoColaboradorId,
  // recuperado 07/08/2026) — guarda o dono anterior quando a linha
  // perde/troca de colaborador.
  ultimoColaboradorId   String?
  ultimoColaborador     Colaborador? @relation("UltimoColaboradorLinha", fields: [ultimoColaboradorId], references: [id])
  status                StatusLinha @default(ATIVA)
  observacoes           String?
  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt

  @@index([status])
  @@index([colaboradorId])
  @@index([ultimoColaboradorId])
  @@map("linhas_telefonicas")
}

enum SituacaoConferenciaLinha {
  NAO_VERIFICADO
  CONFERIDO
  NECESSITA_CONFERENCIA
}

// ---------------------------------------------------------------------------
// Acessos a sistemas
// ---------------------------------------------------------------------------

enum StatusAcesso {
  ATIVO
  BLOQUEADO
  PENDENTE_CRIACAO
  REVOGADO
}

model AcessoSistema {
  id             String   @id @default(cuid())
  colaboradorId  String
  colaborador    Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  sistemaId      String
  sistema        SistemaAcesso @relation(fields: [sistemaId], references: [id])
  status         StatusAcesso @default(ATIVO)
  dataConcessao  DateTime?
  dataRevogacao  DateTime?
  observacoes    String?

  @@unique([colaboradorId, sistemaId])
  @@map("acessos_sistema")
}

// ---------------------------------------------------------------------------
// Lotes de rateio e solicitações de equipamento
// ---------------------------------------------------------------------------

enum StatusLote {
  ABERTO
  FECHADO
}

model LoteRateio {
  id             String   @id @default(cuid())
  nome           String
  descricao      String?
  dataInicio     DateTime?
  dataFechamento DateTime?
  status         StatusLote @default(ABERTO)

  solicitacoes SolicitacaoEquipamento[]

  @@map("lotes_rateio")
}

enum Prioridade {
  ALTA
  MEDIA
  BAIXA
}

enum StatusSolicitacao {
  PENDENTE
  EM_ANALISE
  APROVADO
  EM_COMPRA
  COMPRADO
  ENTREGUE
  CANCELADO
  REPROVADO
}

model SolicitacaoEquipamento {
  id              String   @id @default(cuid())
  solicitanteId   String
  solicitante     Colaborador @relation("Solicitante", fields: [solicitanteId], references: [id])
  // FK obrigatória (ON DELETE RESTRICT — Postgres bloqueia excluir a unidade
  // enquanto houver solicitação vinculada). Recuperado 07/08/2026 a partir do
  // uso real em dominios.routes.ts (verificarUso da rota de Unidades).
  unidadeId       String
  unidade         Unidade  @relation(fields: [unidadeId], references: [id])
  item            String
  justificativa   String?
  prioridade      Prioridade @default(MEDIA)
  loteId          String?
  lote            LoteRateio? @relation(fields: [loteId], references: [id])
  quantidade      Int      @default(1)
  // Decimal para valores monetários — nunca usar float aqui, evita erro de
  // arredondamento acumulado em somas/relatórios financeiros.
  valorUnitario   Decimal  @db.Decimal(10, 2) @default(0)
  aprovadorId     String?
  aprovador       Usuario? @relation("Aprovador", fields: [aprovadorId], references: [id])
  // Referência ao catálogo (recuperado 07/08/2026 a partir do uso real em
  // dominios.routes.ts) — ON DELETE SET NULL: excluir o produto do catálogo
  // não apaga a solicitação já feita, só solta o vínculo (o texto em `item`
  // continua servindo de snapshot legível).
  produtoId       String?
  produto         ProdutoEquipamento? @relation(fields: [produtoId], references: [id], onDelete: SetNull)
  // Categoria "congelada" no momento da solicitação, preenchida a partir do
  // produto (se veio do catálogo) ou escolhida manualmente — mesmo racional
  // de snapshot de ItemSolicitacaoPapelaria.categoriaId. Recuperado
  // 07/08/2026 a partir do uso real em solicitacoes.routes.ts.
  categoriaId     String?
  categoria       CategoriaProdutoEquipamento? @relation(fields: [categoriaId], references: [id])
  // Técnico responsável pela validação (obrigatório desde 09/07/2026,
  // "Ajuste na Estrutura" — pedido do Vini) — distinto de `aprovador`
  // (Financeiro/Administrador decide o custo; o técnico valida a
  // necessidade/viabilidade antes). Recuperado 07/08/2026.
  tecnicoResponsavelId String
  tecnicoResponsavel   Usuario @relation("TecnicoResponsavelSolicitacao", fields: [tecnicoResponsavelId], references: [id])
  // Valor e fornecedor da compra (17/07/2026, pedido do Vini) — preenchidos
  // depois da aprovação, não na criação. Recuperado 07/08/2026.
  fornecedor      String?
  status          StatusSolicitacao @default(PENDENTE)
  dataSolicitacao DateTime @default(now())
  dataPrevista    DateTime?
  dataEntrega     DateTime?
  observacoes     String?
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  @@index([status])
  @@index([loteId])
  @@map("solicitacoes_equipamento")
}

