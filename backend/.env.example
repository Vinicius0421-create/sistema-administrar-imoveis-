# Variáveis de ambiente do backend (Administrar Imóveis).
# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA commite o ".env" real — ele já está no .gitignore, mantenha assim.
# A validação completa (obrigatório vs. opcional, formato) está em src/env.ts.

# ---------------------------------------------------------------------------
# Obrigatórias — o servidor não sobe sem estas duas
# ---------------------------------------------------------------------------

# String de conexão do PostgreSQL.
# Em produção (Railway): copiar do próprio painel do Railway (Postgres → Connect).
# Em desenvolvimento local: apontar para um Postgres local ou um banco de teste dedicado.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/administrar_imoveis"

# Segredo usado para assinar o JWT de acesso (token curto). Mínimo 16 caracteres.
# Gere um valor aleatório forte — nunca reaproveite o de produção em ambiente local.
# Ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=""

# ---------------------------------------------------------------------------
# Opcionais — têm valor padrão sensato, só preencha se precisar mudar
# ---------------------------------------------------------------------------

# Ambiente de execução.
NODE_ENV=development

# Porta e host do servidor Fastify.
PORT=3333
HOST=0.0.0.0

# Origem permitida por CORS (URL do frontend rodando localmente).
CORS_ORIGIN=http://localhost:5173

# Expiração dos tokens.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

# Pasta onde ficam os anexos de chamado de manutenção.
# Em produção aponta para um Railway Volume; em dev, pasta local mesmo.
ANEXOS_DIR=./uploads/anexos-chamados

# Base da URL do frontend — usada só para montar o link do e-mail de
# redefinição de senha (ex: `${FRONTEND_URL}/redefinir-senha?token=...`).
FRONTEND_URL=https://administrar-imoveis.vercel.app

# ---------------------------------------------------------------------------
# Opcionais "de propósito" — sem eles, a funcionalidade correspondente
# simplesmente não ativa (o servidor não quebra, só fica sem aquele recurso)
# ---------------------------------------------------------------------------

# Monitoramento de erro (Sentry). Sem isso, src/instrument.ts não inicia nada.
# Conta gratuita em sentry.io.
SENTRY_DSN=

# Envio de e-mail transacional ("esqueci minha senha"). Sem RESEND_API_KEY,
# a rota /auth/esqueci-senha continua respondendo normalmente (nunca vaza se
# o e-mail existe ou não), só não envia o e-mail de verdade — loga um aviso.
# Conta gratuita em resend.com (até 100 e-mails/dia).
RESEND_API_KEY=
RESEND_FROM_EMAIL="Administrar Imóveis <onboarding@resend.dev>"

# Usados só pelo script de seed (npm run seed) para criar o usuário
# administrador inicial. Não usados pelo servidor em si.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
